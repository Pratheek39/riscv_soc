# Simulation waveforms (regenerated on every run, can exceed GitHub's 100 MB limit)
*.vcd

# Testbench build outputs (regenerate with: cd tb && make)
tb/verilated/
tb/obj/
tb/obj_verilated/
tb/lib/
tb/build/

# Software build outputs (regenerate with: cd sw && make)
sw/build/
# Vivado build outputs (regenerated by fpga/boolean/build_bitstream.tcl)
fpga/boolean/vivado_boolean/
fpga/boolean/.Xil/
fpga/boolean/*.bit
fpga/boolean/*.rpt
/vivado*.log
/vivado*.jou
*.backup.jou
*.backup.log

# Software build outputs (regenerated by make -C sw/fpga)
sw/fpga/build/

# Big-matrix tests: PC programs and generated input files
# (rebuild with: make -C sw host; regenerate with: cd sw && python3 gen_matrices.py)
sw/build_host/
sw/A_*.txt
sw/B_*.txt
