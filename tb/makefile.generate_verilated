###############################################################################
# Variables
###############################################################################
CORE             ?= core
PARAMS           ?= 
OUTPUT_DIR       ?= verilated
SRC_DIR          ?= ../soc
SRC_TYPE         ?= v
SRC_V_DIR        ?= ../soc
OUTPUT_SUFFIX    ?=
SRC              ?= riscv_soc
NAME             ?= riscv_soc

RTL_INCLUDE       = ../core/core/$(CORE)
RTL_INCLUDE      += ../soc
RTL_SOURCES       = $(wildcard $(SRC_DIR)/*.v)
RTL_SOURCES      += $(wildcard ../core/core/$(CORE)/*.v)

# Verilator options
VERILATE_PARAMS  ?= --trace
VERILATOR_OPTS   ?= --pins-sc-uint

TARGETS          ?= $(OUTPUT_DIR)/V$(NAME)

###############################################################################
# Rules
###############################################################################
all: $(TARGETS)

$(OUTPUT_DIR):
	mkdir -p $@

$(OUTPUT_DIR)/V$(NAME): $(RTL_SOURCES) | $(OUTPUT_DIR)
	verilator --sc -Wno-IGNOREDRETURN -Wno-fatal $(RTL_SOURCES) --top-module $(NAME) --Mdir $(OUTPUT_DIR) -I./$(SRC_V_DIR) $(patsubst %,-I%,$(RTL_INCLUDE)) $(VERILATOR_OPTS) $(VERILATE_PARAMS)

clean:
	rm -rf $(TARGETS) $(OUTPUT_DIR)
